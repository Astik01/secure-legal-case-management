# Copy to .env (never commit .env). Values below are DEVELOPMENT-ONLY.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB. `npm run dev:db` starts a persistent local MongoDB on this port.
MONGODB_URI=mongodb://127.0.0.1:27017/legal_case_db

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-string
JWT_EXPIRES_IN=8h

# Private document storage (outside any public/static directory)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Blockchain (backend only; never exposed to the frontend)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_DEPLOYMENT_FILE=../blockchain/deployments/localhost.json
# Hardhat's publicly known test account #0. LOCAL DEVELOPMENT ONLY - holds no real value.
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Seed accounts (development only; override as you wish)
SEED_ADMIN_EMAIL=admin@lawschool.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_FACULTY_EMAIL=faculty@lawschool.test
SEED_FACULTY_PASSWORD=Faculty@12345
SEED_STUDENT_EMAIL=student@lawschool.test
SEED_STUDENT_PASSWORD=Student@12345

# Optional Sepolia deployment (requires Sepolia test ETH)
SEPOLIA_RPC_URL=
SEPOLIA_DEPLOYER_PRIVATE_KEY=
